+WINPTY_API BOOL winpty_config_set_spawn_context(
+        winpty_config_t *cfg, HANDLE token, HANDLE job, DWORD flags,
+        LPCWSTR desktop, LPCWSTR cwd, LPCWSTR env, DWORD envLength,
+        winpty_error_ptr_t *err) {
+    API_TRY {
+        if (cfg == nullptr || job == nullptr || env == nullptr || envLength < 2) {
+            throwWinptyException(L"invalid contained winpty spawn context");
+        }
+        cfg->sandboxToken = token;
+        cfg->sandboxJob = job;
+        cfg->sandboxFlags = flags;
+        cfg->sandboxDesktop = desktop == nullptr ? L"" : desktop;
+        cfg->sandboxCwd = cwd == nullptr ? L"" : cwd;
+        cfg->sandboxEnv.assign(env, envLength);
+        return TRUE;
+    } API_CATCH(FALSE)
+}
