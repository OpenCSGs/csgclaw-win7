+static Sid getLogonSid() {
+    struct Impl : Sid::Impl { std::vector<char> buffer; };
+    auto token = openSecurityTokenForQuery();
+    DWORD length = 0;
+    GetTokenInformation(token.get(), TokenGroups, nullptr, 0, &length);
+    std::unique_ptr<Impl> impl(new Impl);
+    impl->buffer.resize(length);
+    if (!GetTokenInformation(token.get(), TokenGroups, impl->buffer.data(),
+                             length, &length)) {
+        throwWindowsError(L"query logon SID for private console pipe");
+    }
+    const auto groups = reinterpret_cast<TOKEN_GROUPS*>(impl->buffer.data());
+    for (DWORD i = 0; i < groups->GroupCount; ++i) {
+        if ((groups->Groups[i].Attributes & SE_GROUP_LOGON_ID) == SE_GROUP_LOGON_ID) {
+            return Sid(groups->Groups[i].Sid, std::move(impl));
+        }
+    }
+    throwWinptyException(L"missing logon SID for private console pipe");
+}
