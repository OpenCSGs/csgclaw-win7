  },
  {
    "Action": "script",
    "Name": "wav play real media",
    "Script": "let m=window.__activePreview().querySelector('audio');m.muted=true;return m.play().then(()=>true);"
  },
  {
    "Action": "wait",
    "Name": "wav playback clock advanced",
    "Script": "let m=window.__activePreview().querySelector('audio');return !m.error&&m.currentTime>=0.3;"
  },
