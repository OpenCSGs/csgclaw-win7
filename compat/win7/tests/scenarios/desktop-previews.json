    "Selector": ".chat-side-tab-body:not([hidden]) .chat-files-open[title$=\"win7-preview.docx\"]"
  },
  {
    "Action": "wait",
    "Name": "docx preview content",
    "Timeout": 120,
    "Script": "return !!(window.__activePreview()?.textContent.includes(\"WIN7_DOCX_PREVIEW_OK\")) || !!document.querySelector('.document-preview-status.is-error') || document.body.innerText.includes('Unexpected Application Error');"
  },
  {
    "Action": "script",
    "Name": "docx actual rendering assertion",
    "Script": "if(!(window.__activePreview()?.textContent.includes(\"WIN7_DOCX_PREVIEW_OK\")))throw new Error('Preview failed: '+document.body.innerText.slice(-1500));return {errors:window.__win7Errors,content:window.__activePreview().innerText.slice(0,600)};"
  },
  {
    "Action": "screenshot",
    "Path": "webdriver-fixed-preview-docx.png"
  },
