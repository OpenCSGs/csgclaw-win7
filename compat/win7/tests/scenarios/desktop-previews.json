    "Script": "let m=window.__activePreview().querySelector('audio');m.pause();return {currentTime:m.currentTime,duration:m.duration,readyState:m.readyState,width:m.videoWidth,frames:m.getVideoPlaybackQuality?.().totalVideoFrames};"
  },
