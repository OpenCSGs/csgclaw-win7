  {
    "action": "script",
    "name": "preview-monitor",
    "script": "window.__win7Errors=[];window.addEventListener('error',e=>window.__win7Errors.push(e.message));window.addEventListener('unhandledrejection',e=>window.__win7Errors.push(String(e.reason)));window.__activePreview=()=>document.querySelector('.chat-side-tab-body:not([hidden]) .document-preview-panel');return {withResolvers:typeof Promise.withResolvers,ua:navigator.userAgent}"
  },
  {
    "action": "click",
    "selector": ".chat-tools-actions button[aria-label=\"文件\"]"
  },
  {
    "action": "clickText",
    "selector": ".chat-files-sources [role=tab]",
    "text": "工作区文件"
  },
  {
    "action": "wait",
    "name": "synthetic-preview-directory",
    "script": "return Array.from(document.querySelectorAll('.chat-files-open')).some(e=>e.textContent.trim()==='win7-feature-previews')"
  },
