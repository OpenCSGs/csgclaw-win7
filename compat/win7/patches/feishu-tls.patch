--- /dev/null
+++ b/internal/transport/tls_ca_win7_test.go
@@ -0,0 +1,30 @@
+package transport
+
+import (
+	"crypto/tls"
+	"crypto/x509"
+	"encoding/pem"
+	"net/http"
+	"path/filepath"
+	"testing"
+)
+
+func TestWin7ExtraCAPreservesExistingTransportRoots(t *testing.T) {
+	originalPEM := mustCreateTestCertPEM(t)
+	block, _ := pem.Decode(originalPEM)
+	original, err := x509.ParseCertificate(block.Bytes)
+	if err != nil {
+		t.Fatal(err)
+	}
+	roots := x509.NewCertPool()
+	roots.AddCert(original)
+	transport := &http.Transport{TLSClientConfig: &tls.Config{RootCAs: roots}}
+	path := filepath.Join(t.TempDir(), "extra.pem")
+	writeFile(t, path, mustCreateTestCertPEM(t), 0600)
+	if err := applyExtraRootCA(transport, path); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := original.Verify(x509.VerifyOptions{Roots: transport.TLSClientConfig.RootCAs, KeyUsages: []x509.ExtKeyUsage{x509.ExtKeyUsageAny}}); err != nil {
+		t.Fatalf("existing transport trust was discarded: %v", err)
+	}
+}
