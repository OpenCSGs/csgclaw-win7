+)
+
+func TestWindowsReadOnlyCodexToolsE2E(t *testing.T) {
+	binary := os.Getenv("CSGCLAW_TEST_CODEX_BINARY")
+	if binary == "" {
+		t.Skip("set CSGCLAW_TEST_CODEX_BINARY for native read-only verification")
+	}
+	t.Setenv("CSGCLAW_EXECUTION_MODE", ExecutionModeReadOnly)
+	home := t.TempDir()
+	t.Setenv("HOME", home)
+	t.Setenv("CODEX_HOME", filepath.Join(home, "host"))
+	var mu sync.Mutex
+	names := map[string]bool{}
+	requests := 0
+	provider := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		var body map[string]any
+		if err := json.NewDecoder(r.Body).Decode(&body); err != nil {
+			t.Error(err)
+			return
+		}
+		var collect func([]any)
+		collect = func(items []any) {
+			for _, v := range items {
+				if item, ok := v.(map[string]any); ok {
+					if name, ok := item["name"].(string); ok {
+						names[name] = true
+					}
+					if nested, ok := item["tools"].([]any); ok {
+						collect(nested)
+					}
+				}
+			}
+		}
+		mu.Lock()
+		requests++
+		if tools, ok := body["tools"].([]any); ok {
+			collect(tools)
+		}
+		mu.Unlock()
+		w.Header().Set("Content-Type", "text/event-stream")
+		for _, event := range []any{
+			map[string]any{"type": "response.created", "response": map[string]any{"id": "win7-read-only"}},
+			map[string]any{"type": "response.output_item.done", "item": map[string]any{"type": "message", "id": "readonly-final", "role": "assistant", "content": []any{map[string]any{"type": "output_text", "text": "WIN7_READ_ONLY_OK"}}}},
+			map[string]any{"type": "response.completed", "response": map[string]any{"id": "win7-read-only", "usage": map[string]any{"input_tokens": 10, "output_tokens": 10, "total_tokens": 20}}},
+		} {
+			raw, _ := json.Marshal(event)
+			fmt.Fprintf(w, "data: %s\n\n", raw)
+		}
+	}))
+	defer provider.Close()
+	profile := agentruntime.Profile{Provider: "api", ModelID: "win7-native", BaseURL: provider.URL + "/v1", APIKey: "local-test-fixture"}
+	rt := New(Dependencies{EventSink: NewEventSink(), BinaryProvider: fakeBinaryProvider{path: binary}, AgentHome: func(string) (string, error) { return filepath.Join(home, "agent"), nil }, ResolveAgent: func(agentruntime.Handle) (AgentRef, error) {
+		return AgentRef{ID: "win7-read-only", Name: "win7-read-only", Profile: profile, RuntimeOptions: map[string]any{"memory_mode": "disabled", "execution_mode": "read_only"}}, nil
+	}})
+	defer rt.Close()
+	ctx, cancel := context.WithTimeout(context.Background(), 120*time.Second)
+	defer cancel()
+	h, err := rt.New(ctx, agentruntime.Spec{RuntimeID: "win7-read-only", AgentID: "win7-read-only", AgentName: "win7-read-only", Profile: profile})
+	if err != nil {
+		t.Fatal(err)
+	}
+	thread, err := rt.EnsureEngineSession(ctx, h.RuntimeID, "room:read-only")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = rt.Prompt(ctx, h.RuntimeID, thread, "Confirm read-only mode is usable."); err != nil {
+		t.Fatal(err)
+	}
+	mu.Lock()
+	defer mu.Unlock()
+	if requests == 0 {
+		t.Fatal("no native model request observed")
+	}
+	t.Logf("native read-only tool catalog: %v", names)
+	for _, name := range []string{"exec_command", "write_stdin", "shell_command", "shell", "apply_patch"} {
+		if names[name] {
+			t.Errorf("read-only mode exposed local execution tool %s", name)
+		}
+	}
+}
