diff --git a/web/app/tests/shared/pdfBrowserCompatibility.test.ts b/web/app/tests/shared/pdfBrowserCompatibility.test.ts
new file mode 100644
index 00000000..a86432a6
--- /dev/null
+++ b/web/app/tests/shared/pdfBrowserCompatibility.test.ts
@@ -0,0 +1,21 @@
+import { describe, expect, it, vi } from "vitest";
+
+describe("PDF browser compatibility", () => {
+  it("loads the shared PDF engine without native Promise.withResolvers", async () => {
+    const original = Object.getOwnPropertyDescriptor(Promise, "withResolvers");
+    try {
+      Object.defineProperty(Promise, "withResolvers", { configurable: true, writable: true, value: undefined });
+      const pdfjs = await import("pdfjs-dist");
+      const transport = new pdfjs.PDFDataRangeTransport(1, new Uint8Array());
+      const progress = vi.fn();
+      transport.addProgressListener(progress);
+      transport.transportReady();
+      transport.onDataProgress(1, 1);
+      await Promise.resolve();
+      expect(progress).toHaveBeenCalledWith(1, 1);
+    } finally {
+      if (original) Object.defineProperty(Promise, "withResolvers", original);
+      else Reflect.deleteProperty(Promise, "withResolvers");
+    }
+  });
+});
