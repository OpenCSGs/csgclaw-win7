--- /dev/null
+++ b/internal/api/workspace_terminal_windows.go
@@ -0,0 +1,79 @@
+package api
+
+import (
+	"context"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"syscall"
+	"unsafe"
+
+	"golang.org/x/sys/windows"
+)
+
+func windowsWorkspaceTerminal(path string, lookup func(string) (string, error)) (*exec.Cmd, error) {
+	if terminal, err := lookup("wt.exe"); err == nil {
+		return exec.Command(terminal, "-d", strings.ReplaceAll(path, ";", `\;`)), nil
+	}
+	system, err := windows.GetSystemDirectory()
+	if err != nil {
+		return nil, err
+	}
+	command, err := lookup(filepath.Join(system, "cmd.exe"))
+	if err != nil {
+		return nil, err
+	}
+	// The working directory is process metadata, never shell source. /D disables
+	// registry AutoRun commands, and a separate console keeps this interactive.
+	child := exec.Command(command, "/D")
+	child.Dir = path
+	child.SysProcAttr = &syscall.SysProcAttr{CreationFlags: windows.CREATE_NEW_CONSOLE}
+	return child, nil
+}
+
+func windowsWorkspaceTerminalAvailable() bool {
+	_, err := windowsWorkspaceTerminal(".", exec.LookPath)
+	return err == nil
+}
+
+func openWindowsWorkspaceTerminal(ctx context.Context, path string) error {
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	child, err := windowsWorkspaceTerminal(path, exec.LookPath)
+	if err != nil {
+		return err
+	}
+	application, err := windows.UTF16PtrFromString(child.Path)
+	if err != nil {
+		return err
+	}
+	commandLine, err := windows.UTF16PtrFromString(windows.ComposeCommandLine(child.Args))
+	if err != nil {
+		return err
+	}
+	var directory *uint16
+	if child.Dir != "" {
+		directory, err = windows.UTF16PtrFromString(child.Dir)
+		if err != nil {
+			return err
+		}
+	}
+	var flags uint32
+	if child.SysProcAttr != nil {
+		flags = child.SysProcAttr.CreationFlags
+	}
+	startup := windows.StartupInfo{Cb: uint32(unsafe.Sizeof(windows.StartupInfo{}))}
+	var process windows.ProcessInformation
+	// Let Windows initialize real console handles. exec.Cmd would otherwise
+	// redirect its nil input/output to NUL, making the new console unusable.
+	if err := windows.CreateProcess(application, commandLine, nil, nil, false, flags, nil, directory, &startup, &process); err != nil {
+		return err
+	}
+	windows.CloseHandle(process.Thread)
+	go func() {
+		windows.WaitForSingleObject(process.Process, windows.INFINITE)
+		windows.CloseHandle(process.Process)
+	}()
+	return nil
+}
