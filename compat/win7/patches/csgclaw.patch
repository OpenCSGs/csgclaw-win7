@@ -0,0 +1,116 @@
+package processgroup
+
+import (
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"syscall"
+	"testing"
+	"time"
+
+	"golang.org/x/sys/windows"
+)
+
+func TestWindowsChildJobHelper(t *testing.T) {
+	if os.Getenv("CSGCLAW_WINDOWS_CHILD_JOB_TEST") != "owner" {
+		return
+	}
+	child := exec.Command(os.Args[0], "-test.run=^TestProcessGroupHelper$")
+	child.Env = append(os.Environ(), "CSGCLAW_PROCESS_GROUP_TEST=child")
+	child.SysProcAttr = &syscall.SysProcAttr{CreationFlags: windows.CREATE_BREAKAWAY_FROM_JOB}
+	if err := Start(child); err != nil {
+		os.Exit(2)
+	}
+	if err := os.WriteFile(os.Getenv("CSGCLAW_PROCESS_GROUP_READY")+".pid", []byte(strconv.Itoa(child.Process.Pid)), 0600); err != nil {
+		os.Exit(3)
+	}
+	time.Sleep(time.Minute)
+	os.Exit(0)
+}
+
+func TestCooperatingChildJobCleanup(t *testing.T) {
+	for _, termination := range []string{"stop", "owner-crash"} {
+		t.Run(termination, func(t *testing.T) {
+			ready := filepath.Join(t.TempDir(), "ready")
+			cmd := exec.Command(os.Args[0], "-test.run=^TestWindowsChildJobHelper$")
+			cmd.Env = append(os.Environ(), "CSGCLAW_WINDOWS_CHILD_JOB_TEST=owner", "CSGCLAW_PROCESS_GROUP_READY="+ready)
+			if err := StartWithChildJobs(cmd); err != nil {
+				t.Fatal(err)
+			}
+			t.Cleanup(func() { _ = Stop(cmd.Process.Pid, true) })
+			var pid int
+			deadline := time.Now().Add(20 * time.Second)
+			for time.Now().Before(deadline) {
+				data, err := os.ReadFile(ready + ".pid")
+				if err == nil {
+					pid, err = strconv.Atoi(strings.TrimSpace(string(data)))
+					if err == nil && pid > 0 {
+						break
+					}
+				}
+				time.Sleep(20 * time.Millisecond)
+			}
+			if pid == 0 {
+				t.Fatal("cooperating child did not start its own job")
+			}
+			child, err := windows.OpenProcess(windows.SYNCHRONIZE, false, uint32(pid))
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer windows.CloseHandle(child)
+			if termination == "stop" {
+				err = Stop(cmd.Process.Pid, true)
+			} else {
+				err = cmd.Process.Kill()
+			}
+			if err != nil {
+				t.Fatal(err)
+			}
+			_ = cmd.Wait()
+			state, err := windows.WaitForSingleObject(child, 5000)
+			if err != nil || state != windows.WAIT_OBJECT_0 {
+				t.Fatalf("command job survived owner termination: state=%d err=%v", state, err)
+			}
+		})
+	}
+}
+
+func TestMain(m *testing.M) {
+	if os.Getenv("CSGCLAW_TASKKILL_PROBE") != "" {
+		if err := os.WriteFile(os.Getenv("CSGCLAW_TASKKILL_PROBE"), []byte("invoked"), 0600); err != nil {
+			os.Exit(2)
+		}
+		os.Exit(0)
+	}
+	os.Exit(m.Run())
+}
+
+func TestStopExitedProcessDoesNotLaunchTaskkill(t *testing.T) {
+	cmd := exec.Command(`C:\Windows\System32\cmd.exe`, "/d", "/c", "exit 0")
+	if err := cmd.Run(); err != nil {
+		t.Fatal(err)
+	}
+	dir := t.TempDir()
+	self, err := os.Executable()
+	if err != nil {
+		t.Fatal(err)
+	}
+	data, err := os.ReadFile(self)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = os.WriteFile(filepath.Join(dir, "taskkill.exe"), data, 0755); err != nil {
+		t.Fatal(err)
+	}
+	marker := filepath.Join(dir, "taskkill-invoked.txt")
+	t.Setenv("PATH", dir)
+	t.Setenv("CSGCLAW_TASKKILL_PROBE", marker)
+	if err = Stop(cmd.Process.Pid, true); err != nil {
+		t.Fatal(err)
+	}
+	if _, err = os.Stat(marker); !os.IsNotExist(err) {
+		t.Fatalf("stopping an already-exited process launched taskkill: %v", err)
+	}
+}
