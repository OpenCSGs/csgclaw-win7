+)
+
+func TestWindowsInteractiveCodexToolsE2E(t *testing.T) {
+	binary := os.Getenv("CSGCLAW_TEST_CODEX_BINARY")
+	if binary == "" {
+		t.Skip("set CSGCLAW_TEST_CODEX_BINARY for native interactive verification")
+	}
+	probe := os.Getenv("CSGCLAW_TEST_CONSOLE_PROBE")
+	if probe == "" {
+		t.Skip("set CSGCLAW_TEST_CONSOLE_PROBE to the native console fixture")
+	}
+	home := t.TempDir()
+	t.Setenv("HOME", home)
+	t.Setenv("CODEX_HOME", filepath.Join(home, "host"))
+	var mu sync.Mutex
+	var advertised []string
+	seenAdvertised := map[string]bool{}
+	namespaces := map[string]string{}
+	patchRequested := false
+	patchCommand := ""
+	patchExited := false
+	output := ""
+	command := ""
+	started, sent := false, false
+	consoleExited := false
+	seenOutputs := map[string]bool{}
+	sessionID := 0
+	requests := 0
+	sessionPattern := regexp.MustCompile(`Process running with session ID (\d+)`)
+	provider := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		var body map[string]any
+		if err := json.NewDecoder(r.Body).Decode(&body); err != nil {
+			t.Error(err)
+			return
+		}
+		var collect func([]any)
+		collect = func(tools []any) {
+			for _, value := range tools {
+				tool, ok := value.(map[string]any)
+				if !ok {
+					continue
+				}
+				if name, ok := tool["name"].(string); ok {
+					if !seenAdvertised[name] {
+						advertised = append(advertised, name)
+						seenAdvertised[name] = true
+					}
+				}
+				if nested, ok := tool["tools"].([]any); ok {
+					for _, child := range nested {
+						if child, ok := child.(map[string]any); ok {
+							if n, ok := child["name"].(string); ok {
+								namespaces[n], _ = tool["name"].(string)
+							}
+						}
+					}
+					collect(nested)
+				}
+			}
+		}
+		mu.Lock()
+		if tools, ok := body["tools"].([]any); ok {
+			collect(tools)
+		}
+
+		defer mu.Unlock()
+		requests++
+		latest := ""
+		if input, ok := body["input"].([]any); ok {
+			for _, v := range input {
+				if item, ok := v.(map[string]any); ok && (item["type"] == "function_call_output" || item["type"] == "custom_tool_call_output") {
+					latest = fmt.Sprint(item["output"])
+					id, _ := item["call_id"].(string)
+					if !seenOutputs[id] {
+						output += "\n" + latest
+						seenOutputs[id] = true
+					}
+				}
+			}
+		}
+		if strings.Contains(latest, "Process exited with code 0") {
+			if patchRequested {
+				patchExited = true
+			} else {
+				consoleExited = true
+			}
+		}
+		if match := sessionPattern.FindStringSubmatch(latest); len(match) == 2 {
+			sessionID, _ = strconv.Atoi(match[1])
+		}
+		name := ""
+		args := map[string]any{}
+		switch {
+		case !started:
+			started = true
+			name = "exec_command"
+			args = map[string]any{"cmd": command, "tty": true, "yield_time_ms": 1000, "max_output_tokens": 3000}
+		case !sent && sessionID != 0:
+			name = "write_stdin"
+			args = map[string]any{"session_id": sessionID, "chars": "", "yield_time_ms": 1000, "max_output_tokens": 3000}
+			if strings.Contains(output, "WIN7_REAL_CONSOLE_READY") {
+				sent = true
