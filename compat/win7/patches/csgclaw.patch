+
+// This helper runs inside the actual restricted Codex command process tree.
+func TestWin7SandboxHelper(t *testing.T) {
+	mode := os.Getenv("CSGCLAW_WIN7_E2E_HELPER")
+	if mode == "" {
+		return
+	}
+	ready := os.Getenv("CSGCLAW_WIN7_E2E_READY")
+	if mode == "work" {
+		if err := os.WriteFile("win7-workspace.txt", []byte("workspace write"), 0600); err != nil {
+			fmt.Println(err)
+			os.Exit(2)
+		}
+		if err := os.WriteFile(os.Getenv("CSGCLAW_WIN7_E2E_OUTSIDE"), []byte("unexpected"), 0600); !os.IsPermission(err) {
+			fmt.Println("outside write was not denied", err)
+			os.Exit(3)
+		}
+		fmt.Println("WIN7_NATIVE_WORKSPACE_OK")
+		os.Exit(0)
+	}
+	if mode == "child" {
+		if err := os.WriteFile(ready+".child", []byte("ready"), 0600); err != nil {
+			os.Exit(4)
+		}
+		time.Sleep(5 * time.Minute)
+		os.Exit(0)
+	}
+	child := exec.Command(os.Args[0], "-test.run=^TestWin7SandboxHelper$")
+	child.Env = append(os.Environ(), "CSGCLAW_WIN7_E2E_HELPER=child")
+	if err := child.Start(); err != nil {
+		fmt.Println(err)
+		os.Exit(5)
+	}
+	data, _ := json.Marshal([]int{os.Getpid(), child.Process.Pid})
+	if err := os.WriteFile(ready, data, 0600); err != nil {
+		fmt.Println(err)
+		os.Exit(7)
+	}
+	if mode == "background_stop" {
+		fmt.Println("WIN7_BACKGROUND_STARTED")
+		os.Exit(0)
+	}
+	time.Sleep(5 * time.Minute)
+	os.Exit(0)
+}
+
+func TestWindowsWorkspaceSandboxCodexE2E(t *testing.T) {
+	binary := os.Getenv("CSGCLAW_TEST_CODEX_BINARY")
+	if binary == "" {
+		t.Skip("set CSGCLAW_TEST_CODEX_BINARY for native Windows lifecycle verification")
+	}
+	for _, mode := range []string{"work", "cancel", "timeout", "background_stop", "owner_crash"} {
+		t.Run(mode, func(t *testing.T) {
+			home := t.TempDir()
+			t.Setenv("HOME", home)
+			t.Setenv("CODEX_HOME", filepath.Join(home, "host"))
+			outside := filepath.Join(filepath.Dir(binary), "outside-workspace")
+			if err := os.MkdirAll(outside, 0700); err != nil {
+				t.Fatal(err)
+			}
+			var mu sync.Mutex
+			calls := 0
+			output := ""
+			command := ""
+			unified := false
+			resumeOnly := false
+			sessionPattern := regexp.MustCompile(`Process running with session ID (\d+)`)
+			provider := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				if r.URL.Path != "/v1/responses" {
+					http.NotFound(w, r)
+					return
+				}
+				var body map[string]any
+				if err := json.NewDecoder(r.Body).Decode(&body); err != nil {
+					t.Error(err)
+					return
+				}
+				mu.Lock()
+				defer mu.Unlock()
+				calls++
+				latest := ""
+				if items, ok := body["input"].([]any); ok {
+					for _, v := range items {
+						if m, ok := v.(map[string]any); ok && m["type"] == "function_call_output" {
+							latest = fmt.Sprint(m["output"])
+							output += latest
+						}
+					}
+				}
+				name, namespace := "", ""
+				writeNamespace := ""
+				var find func([]any, string)
+				find = func(tools []any, ns string) {
+					for _, v := range tools {
+						m, ok := v.(map[string]any)
+						if !ok {
+							continue
+						}
+						n, _ := m["name"].(string)
+						if n == "write_stdin" {
+							writeNamespace = ns
+						}
+						if n == "shell_command" || n == "exec_command" {
+							name = n
+							namespace = ns
+							return
+						}
+						if nested, ok := m["tools"].([]any); ok {
+							find(nested, n)
+							if name != "" {
+								return
+							}
+						}
+					}
+				}
+				if tools, ok := body["tools"].([]any); ok {
+					find(tools, "")
+					for _, v := range tools {
+						if tool, ok := v.(map[string]any); ok {
+							if nested, ok := tool["tools"].([]any); ok {
+								for _, v := range nested {
+									if child, ok := v.(map[string]any); ok && child["name"] == "write_stdin" {
+										writeNamespace, _ = tool["name"].(string)
+									}
+								}
+							}
+						}
+					}
+				}
+				w.Header().Set("Content-Type", "text/event-stream")
+				emit := func(v any) { raw, _ := json.Marshal(v); fmt.Fprintf(w, "data: %s\n\n", raw) }
+				emit(map[string]any{"type": "response.created", "response": map[string]any{"id": "win7-native"}})
+				if calls == 1 {
+					if name == "" {
+						t.Error("no native shell tool advertised")
+					}
+					args := map[string]any{"command": command, "timeout_ms": 60000}
+					if mode == "timeout" {
+						args["timeout_ms"] = 30000
+					}
+					if name == "exec_command" {
+						unified = true
+						args = map[string]any{"cmd": command, "tty": true, "yield_time_ms": 1000, "max_output_tokens": 2000}
+					}
+					raw, _ := json.Marshal(args)
+					item := map[string]any{"type": "function_call", "call_id": "win7-native-tool", "name": name, "arguments": string(raw)}
+					if namespace != "" {
+						item["namespace"] = namespace
+					}
+					emit(map[string]any{"type": "response.output_item.done", "item": item})
+				} else if match := sessionPattern.FindStringSubmatch(latest); unified && !resumeOnly && len(match) == 2 && calls < 60 {
+					sessionID, _ := strconv.Atoi(match[1])
+					raw, _ := json.Marshal(map[string]any{"session_id": sessionID, "chars": "", "yield_time_ms": 1000, "max_output_tokens": 2000})
+					item := map[string]any{"type": "function_call", "call_id": fmt.Sprintf("win7-poll-%d", calls), "name": "write_stdin", "arguments": string(raw)}
+					if writeNamespace != "" {
+						item["namespace"] = writeNamespace
+					}
+					emit(map[string]any{"type": "response.output_item.done", "item": item})
+				} else {
+					emit(map[string]any{"type": "response.output_item.done", "item": map[string]any{"type": "message", "id": "win7-final", "role": "assistant", "content": []any{map[string]any{"type": "output_text", "text": "WIN7_NATIVE_TURN_DONE"}}}})
+				}
+				emit(map[string]any{"type": "response.completed", "response": map[string]any{"id": "win7-native", "usage": map[string]any{"input_tokens": 20, "output_tokens": 20, "total_tokens": 40}}})
+			}))
+			defer provider.Close()
+			profile := agentruntime.Profile{Provider: "api", ModelID: "win7-native", BaseURL: provider.URL + "/v1", APIKey: "local-test-fixture"}
+			agentHome := filepath.Join(home, "agent")
+			rt := New(Dependencies{EventSink: NewEventSink(), BinaryProvider: fakeBinaryProvider{path: binary}, AgentHome: func(string) (string, error) { return agentHome, nil }, ResolveAgent: func(agentruntime.Handle) (AgentRef, error) {
+				return AgentRef{ID: "win7-agent", Name: "win7-agent", Profile: profile, RuntimeOptions: map[string]any{"memory_mode": "disabled"}}, nil
+			}})
+			defer rt.Close()
+			t.Cleanup(func() {
+				if t.Failed() {
+					logs, _ := os.ReadFile(rt.Layout(agentHome).HostLogPaths[0])
+					t.Logf("native Codex stderr: %s", logs)
+					mu.Lock()
+					t.Logf("model requests=%d tool output=%s", calls, output)
+					mu.Unlock()
+				}
+			})
+			ctx, cancel := context.WithTimeout(context.Background(), 180*time.Second)
+			defer cancel()
+			h, err := rt.New(ctx, agentruntime.Spec{RuntimeID: "win7-runtime", AgentID: "win7-agent", AgentName: "win7-agent", Profile: profile})
+			if err != nil {
+				t.Fatal(err)
+			}
+			thread, err := rt.EnsureEngineSession(ctx, h.RuntimeID, "room:win7-native")
+			if err != nil {
+				t.Fatal(err)
+			}
+			workspace, err := rt.WorkspaceDir(h.RuntimeID)
+			if err != nil {
+				t.Fatal(err)
+			}
+			config, err := os.ReadFile(filepath.Join(filepath.Dir(rt.Layout(agentHome).SkillsRoot), "config.toml"))
+			if err != nil {
+				t.Fatal(err)
+			}
+			for _, want := range []string{`sandbox_mode = "workspace-write"`, `sandbox = "unelevated"`} {
+				if !strings.Contains(string(config), want) {
+					t.Fatalf("missing default sandbox setting %s", want)
+				}
+			}
+			ready := filepath.Join(workspace, "lifecycle.json")
+			self, err := os.Executable()
+			if err != nil {
+				t.Fatal(err)
+			}
+			quote := func(s string) string { return "'" + strings.ReplaceAll(s, "'", "''") + "'" }
+			command = "$env:CSGCLAW_WIN7_E2E_HELPER=" + quote(mode) + "; $env:CSGCLAW_WIN7_E2E_READY=" + quote(ready) + "; $env:CSGCLAW_WIN7_E2E_OUTSIDE=" + quote(filepath.Join(outside, "denied.txt")) + "; & " + quote(self) + " '-test.run=^TestWin7SandboxHelper$'"
+			promptCtx, stop := context.WithCancel(ctx)
+			if mode == "timeout" {
+				stop()
+				promptCtx, stop = context.WithTimeout(ctx, 60*time.Second)
+			}
+			defer stop()
+			done := make(chan error, 1)
+			go func() { done <- rt.Prompt(promptCtx, h.RuntimeID, thread, "Run the native lifecycle fixture.") }()
+			var children []windows.Handle
+			if mode != "work" {
+				deadline := time.Now().Add(45 * time.Second)
+				for time.Now().Before(deadline) {
+					data, e := os.ReadFile(ready)
+					var pids []uint32
+					if e == nil && json.Unmarshal(data, &pids) == nil && len(pids) == 2 {
+						for index, pid := range pids {
+							if mode == "background_stop" && index == 0 {
+								continue
+							}
+							handle, e := windows.OpenProcess(windows.SYNCHRONIZE, false, pid)
+							if e != nil {
+								t.Fatal(e)
+							}
+							children = append(children, handle)
+						}
+						break
+					}
+					select {
+					case e := <-done:
+						t.Fatalf("turn ended before descendants started: %v", e)
+					default:
+					}
+					time.Sleep(25 * time.Millisecond)
+				}
+				expectedHandles := 2
+				if mode == "background_stop" {
+					expectedHandles = 1
+				}
+				if len(children) != expectedHandles {
+					t.Fatal("descendant fixture did not start")
+				}
+				defer func() {
+					for _, h := range children {
+						windows.CloseHandle(h)
+					}
+				}()
+			}
+			if mode == "cancel" {
+				stop()
+			}
+			if mode == "owner_crash" {
+				live := rt.SessionManager().(*appServerManager).liveSession(h.RuntimeID)
+				if err := live.cmd.Process.Kill(); err != nil {
+					t.Fatal(err)
+				}
+			}
+			select {
+			case err = <-done:
+			case <-time.After(70 * time.Second):
+				t.Fatal("turn did not finish")
+			}
+			mu.Lock()
+			usesUnified := unified
+			mu.Unlock()
+			if mode == "cancel" && !errors.Is(err, context.Canceled) {
+				t.Fatalf("cancel result: %v", err)
+			}
+			if mode == "owner_crash" && (err == nil || !strings.Contains(err.Error(), "app-server exited")) {
+				t.Fatalf("app-server crash was not reported: %v", err)
+			}
+			if mode == "timeout" && usesUnified && !errors.Is(err, context.DeadlineExceeded) {
+				t.Fatalf("CSGClaw turn deadline: %v", err)
+			}
+			if mode != "cancel" && mode != "owner_crash" && !(mode == "timeout" && usesUnified) && err != nil {
+				t.Fatal(err)
+			}
+			if mode == "background_stop" {
+				if state, e := windows.WaitForSingleObject(children[len(children)-1], 0); e != nil || state != uint32(windows.WAIT_TIMEOUT) {
+					t.Fatalf("background child was not preserved: %d %v", state, e)
+				}
+				if err := rt.Close(); err != nil {
+					t.Fatal(err)
+				}
+			}
+			for _, child := range children {
+				if state, e := windows.WaitForSingleObject(child, 10000); e != nil || state != windows.WAIT_OBJECT_0 {
+					t.Fatalf("descendant survived %s: state=%d err=%v", mode, state, e)
+				}
+			}
+			mu.Lock()
+			got := output
+			mu.Unlock()
+			if mode == "work" && !strings.Contains(got, "WIN7_NATIVE_WORKSPACE_OK") {
+				t.Fatalf("sandbox tool output: %s", got)
+			}
+			if mode == "timeout" && !usesUnified && !strings.Contains(strings.ToLower(got), "timed out") {
+				t.Fatalf("timeout was not reported: %s", got)
+			}
+			if mode == "cancel" || mode == "timeout" {
+				mu.Lock()
+				resumeOnly = true
+				mu.Unlock()
+				if err := rt.Prompt(ctx, h.RuntimeID, thread, "Confirm this session still works after the previous interruption."); err != nil {
+					t.Fatalf("session recovery: %v", err)
+				}
+			}
+		})
+	}
+}
