+package api
+
+import (
+	"errors"
+	"os/exec"
+	"path/filepath"
+	"reflect"
+	"strings"
+	"testing"
+
+	"golang.org/x/sys/windows"
+)
+
+func TestWindowsWorkspaceTerminalWithoutWindowsTerminal(t *testing.T) {
+	system, err := windows.GetSystemDirectory()
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, path := range []string{`C:\workspace\中文 & echo bad; %PATH%`, `\\server\share\work`} {
+		child, err := windowsWorkspaceTerminal(path, func(name string) (string, error) {
+			if name == "wt.exe" {
+				return "", exec.ErrNotFound
+			}
+			return exec.LookPath(name)
+		})
+		if err != nil {
+			t.Fatal(err)
+		}
+		want := filepath.Join(system, "cmd.exe")
+		if !strings.EqualFold(child.Path, want) || !reflect.DeepEqual(child.Args, []string{want, "/D"}) || child.Dir != path || child.SysProcAttr.CreationFlags != windows.CREATE_NEW_CONSOLE {
+			t.Fatalf("unsafe terminal launch: path=%q args=%q dir=%q attr=%+v", child.Path, child.Args, child.Dir, child.SysProcAttr)
+		}
+	}
+	if _, err := windowsWorkspaceTerminal(".", func(string) (string, error) { return "", errors.New("unavailable") }); err == nil {
+		t.Fatal("accepted unavailable system terminal")
+	}
+}
+
+func TestWindowsWorkspaceTerminalPrefersWindowsTerminal(t *testing.T) {
+	path := `C:\workspace\docs;calc.exe`
+	child, err := windowsWorkspaceTerminal(path, func(name string) (string, error) { return name, nil })
+	if err != nil || !reflect.DeepEqual(child.Args, []string{"wt.exe", "-d", `C:\workspace\docs\;calc.exe`}) || child.Dir != "" {
+		t.Fatalf("Windows Terminal launch: %v %v", child, err)
+	}
+}
