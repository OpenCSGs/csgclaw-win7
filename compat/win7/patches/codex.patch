diff --git a/codex-rs/.config/nextest.toml b/codex-rs/.config/nextest.toml
index f3f3ca2..23a946b 100644
--- a/codex-rs/.config/nextest.toml
+++ b/codex-rs/.config/nextest.toml
@@ -82,3 +82,10 @@ platform = 'cfg(windows)'
 filter = 'test(suite::resume::) | test(suite::cli_stream::) | test(suite::auth_env::) | test(start_thread_uses_all_default_environments_from_codex_home) | test(connect_stdio_command_initializes_json_rpc_client_on_windows)'
 test-group = 'windows_process_heavy'
 slow-timeout = { period = "45s", terminate-after = 2 }
+
+[[profile.default.overrides]]
+# These tests measure concurrency inside a turn with wall-clock assertions.
+# Reserve the runner pool so other test processes cannot skew those measurements.
+# https://nexte.st/docs/configuration/threads-required/
+filter = 'package(codex-core) & kind(test) & test(suite::tool_parallelism::)'
+threads-required = 'num-test-threads'
