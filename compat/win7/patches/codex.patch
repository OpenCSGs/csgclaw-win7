@@ -0,0 +1,272 @@
+//! WinPTY console transport for systems without ConPTY.
+//!
+//! The bundled DLL extension starts its trusted console agent suspended under
+//! the requested token, then assigns the command job before allowing it to run.
+//! User commands inherit both the token and the non-breakaway job from that agent.
+
+use anyhow::Context;
+use anyhow::Result;
+use anyhow::bail;
+use filedescriptor::FileDescriptor;
+use portable_pty::CommandBuilder;
+use shared_library::shared_library;
+use std::ffi::c_void;
+use std::os::windows::io::AsRawHandle;
+use std::os::windows::io::FromRawHandle;
+use std::os::windows::io::OwnedHandle;
+use std::os::windows::io::RawHandle;
+use std::ptr;
+use std::sync::Arc;
+use std::sync::Mutex;
+use std::sync::OnceLock;
+use winapi::um::fileapi::CreateFileW;
+use winapi::um::fileapi::OPEN_EXISTING;
+use winapi::um::handleapi::INVALID_HANDLE_VALUE;
+use winapi::um::winbase::CREATE_BREAKAWAY_FROM_JOB;
+use winapi::um::winnt::FILE_ATTRIBUTE_NORMAL;
+use winapi::um::winnt::GENERIC_READ;
+use winapi::um::winnt::GENERIC_WRITE;
+
+use crate::TerminalSize;
+use crate::win::JobObject;
+use crate::win::legacy_windows_jobs;
+use crate::win::psuedocon::build_cmdline;
+use crate::win::psuedocon::build_environment_block;
+use crate::win::psuedocon::resolve_current_directory;
+
+type Opaque = *mut c_void;
+
+shared_library!(WinPtyApi,
+    fn winpty_config_new(flags: u64, error: *mut Opaque) -> Opaque,
+    fn winpty_config_free(config: Opaque),
+    fn winpty_config_set_initial_size(config: Opaque, cols: i32, rows: i32),
+    fn winpty_config_set_spawn_context(config: Opaque, token: RawHandle, job: RawHandle, flags: u32, desktop: *const u16, cwd: *const u16, env: *const u16, env_len: u32, error: *mut Opaque) -> i32,
+    fn winpty_open(config: Opaque, error: *mut Opaque) -> Opaque,
+    fn winpty_conin_name(pty: Opaque) -> *const u16,
+    fn winpty_conout_name(pty: Opaque) -> *const u16,
+    fn winpty_spawn_config_new(flags: u64, app: *const u16, command: *const u16, cwd: *const u16, env: *const u16, error: *mut Opaque) -> Opaque,
+    fn winpty_spawn_config_free(config: Opaque),
+    fn winpty_spawn(pty: Opaque, config: Opaque, process: *mut RawHandle, thread: *mut RawHandle, create_error: *mut u32, error: *mut Opaque) -> i32,
+    fn winpty_set_size(pty: Opaque, cols: i32, rows: i32, error: *mut Opaque) -> i32,
+    fn winpty_error_msg(error: Opaque) -> *const u16,
+    fn winpty_error_free(error: Opaque),
+    fn winpty_free(pty: Opaque),
+);
+
+static API: OnceLock<std::result::Result<WinPtyApi, String>> = OnceLock::new();
+
+fn api() -> Result<&'static WinPtyApi> {
+    API.get_or_init(|| {
+        let path = std::env::current_exe()
+            .map_err(|error| error.to_string())?
+            .parent()
+            .context("missing executable directory")
+            .map_err(|error| error.to_string())?
+            .join("winpty.dll");
+        // Load only the library next to this executable. Never search the
+        // workspace, PATH, or a caller-provided environment override.
+        WinPtyApi::open(&path).map_err(|error| format!("{error:?}"))
+    })
+    .as_ref()
+    .map_err(|error| anyhow::anyhow!("WinPTY backend unavailable: {error}"))
+}
+
+pub fn supported() -> bool {
+    api().is_ok()
+}
+
+fn error(api: &WinPtyApi, raw: Opaque, operation: &str) -> anyhow::Error {
+    if raw.is_null() {
+        return anyhow::anyhow!("{operation} failed");
+    }
+    // The library owns a NUL-terminated message until winpty_error_free.
+    let message = unsafe {
+        let text = (api.winpty_error_msg)(raw);
+        let mut len = 0;
+        while *text.add(len) != 0 {
+            len += 1;
+        }
+        let message = String::from_utf16_lossy(std::slice::from_raw_parts(text, len));
+        (api.winpty_error_free)(raw);
+        message
+    };
+    anyhow::anyhow!("{operation}: {message}")
+}
+
+/// Owns an agent and serializes its control operations independently of pipe I/O.
+pub struct WinPtySession {
+    api: &'static WinPtyApi,
+    raw: Option<usize>,
+    pub(crate) job: Arc<JobObject>,
+}
+
+/// Handles transferred to the caller after a contained command has been started.
+pub struct WinPtySpawn {
+    pub session: Arc<Mutex<WinPtySession>>,
+    pub process: OwnedHandle,
+    pub thread: OwnedHandle,
+    pub input: FileDescriptor,
+    pub output: FileDescriptor,
+    /// Platform launch resources retained until process output has drained.
+    pub owner: Option<Box<dyn Send>>,
+    pub(crate) job: Arc<JobObject>,
+}
+
+impl WinPtySession {
+    /// Starts a console command with the requested token and an owned command job.
+    pub fn spawn(
+        command: CommandBuilder,
+        token: Option<RawHandle>,
+        job: Arc<JobObject>,
+        size: TerminalSize,
+        desktop: Option<&[u16]>,
+    ) -> Result<WinPtySpawn> {
+        if size.rows == 0
+            || size.cols == 0
+            || size.rows > i16::MAX as u16
+            || size.cols > i16::MAX as u16
+        {
+            bail!("invalid WinPTY terminal dimensions");
+        }
+        if desktop.is_some_and(|name| name.last() != Some(&0)) {
+            bail!("WinPTY desktop name must be NUL terminated");
+        }
+        let api = api()?;
+        let mut issue = ptr::null_mut();
+        let cfg = unsafe {
+            (api.winpty_config_new)(/*flags*/ 0, &mut issue)
+        };
+        if cfg.is_null() {
+            return Err(error(api, issue, "configure WinPTY"));
+        }
+        let cwd = resolve_current_directory(&command).unwrap_or_else(|| vec![0]);
+        let mut env = build_environment_block(&command);
+        if env.len() == 1 {
+            env.push(0);
+        }
+        let flags = if legacy_windows_jobs() {
+            CREATE_BREAKAWAY_FROM_JOB
+        } else {
+            0
+        };
+        let configured = unsafe {
+            (api.winpty_config_set_initial_size)(cfg, i32::from(size.cols), i32::from(size.rows));
+            (api.winpty_config_set_spawn_context)(
+                cfg,
+                token.unwrap_or(ptr::null_mut()),
+                job.as_raw_handle(),
+                flags,
+                desktop.map_or(ptr::null(), |name| name.as_ptr()),
+                cwd.as_ptr(),
+                env.as_ptr(),
+                env.len() as u32,
+                &mut issue,
+            )
+        };
+        if configured == 0 {
+            unsafe { (api.winpty_config_free)(cfg) };
+            return Err(error(api, issue, "configure contained WinPTY agent"));
+        }
+        let raw = unsafe { (api.winpty_open)(cfg, &mut issue) };
+        unsafe { (api.winpty_config_free)(cfg) };
+        if raw.is_null() {
+            return Err(error(api, issue, "start contained WinPTY agent"));
+        }
+        let session = Self {
+            api,
+            raw: Some(raw as usize),
+            job,
+        };
+        let open_pipe = |name, access| -> Result<FileDescriptor> {
+            let handle = unsafe {
+                CreateFileW(
+                    name,
+                    access,
+                    /*dwShareMode*/ 0,
+                    ptr::null_mut(),
+                    OPEN_EXISTING,
+                    FILE_ATTRIBUTE_NORMAL,
+                    ptr::null_mut(),
+                )
+            };
+            if handle == INVALID_HANDLE_VALUE {
+                return Err(std::io::Error::last_os_error()).context("connect WinPTY console pipe");
+            }
+            Ok(unsafe { FileDescriptor::from_raw_handle(handle.cast()) })
+        };
+        let input = open_pipe(unsafe { (api.winpty_conin_name)(raw) }, GENERIC_WRITE)?;
+        let output = open_pipe(unsafe { (api.winpty_conout_name)(raw) }, GENERIC_READ)?;
+        let (app, line) = build_cmdline(&command)?;
+        let spawn_cfg = unsafe {
+            (api.winpty_spawn_config_new)(
+                /*flags*/ 3,
+                app.as_ptr(),
+                line.as_ptr(),
+                cwd.as_ptr(),
+                env.as_ptr(),
+                &mut issue,
+            )
+        };
+        if spawn_cfg.is_null() {
+            return Err(error(api, issue, "configure WinPTY command"));
+        }
+        let mut process = ptr::null_mut();
+        let mut thread = ptr::null_mut();
+        let mut create_error = 0;
+        let spawned = unsafe {
+            (api.winpty_spawn)(
+                raw,
+                spawn_cfg,
+                &mut process,
+                &mut thread,
+                &mut create_error,
+                &mut issue,
+            )
+        };
+        unsafe { (api.winpty_spawn_config_free)(spawn_cfg) };
+        if spawned == 0 {
+            return Err(error(api, issue, "start restricted console command"));
+        }
+        Ok(WinPtySpawn {
+            job: Arc::clone(&session.job),
+            session: Arc::new(Mutex::new(session)),
+            process: unsafe { OwnedHandle::from_raw_handle(process) },
+            thread: unsafe { OwnedHandle::from_raw_handle(thread) },
+            input,
+            output,
+            owner: None,
+        })
+    }
+
+    pub fn resize(&mut self, size: TerminalSize) -> Result<()> {
+        let Some(raw) = self.raw else {
+            bail!("console session already closed")
+        };
+        let mut issue = ptr::null_mut();
+        if unsafe {
+            (self.api.winpty_set_size)(
+                raw as Opaque,
+                i32::from(size.cols),
+                i32::from(size.rows),
+                &mut issue,
+            )
+        } == 0
+        {
+            return Err(error(self.api, issue, "resize WinPTY console"));
+        }
+        Ok(())
+    }
+
+    pub fn close(&mut self) {
+        if let Some(raw) = self.raw.take() {
+            unsafe { (self.api.winpty_free)(raw as Opaque) };
+        }
+    }
+}
+
+impl Drop for WinPtySession {
+    fn drop(&mut self) {
+        let _ = self.job.terminate();
+        self.close();
+    }
+}
diff --git a/codex-rs/utils/pty/src/win/winpty_driver.rs b/codex-rs/utils/pty/src/win/winpty_driver.rs
new file mode 100644
index 0000000..d3c627d
--- /dev/null
+++ b/codex-rs/utils/pty/src/win/winpty_driver.rs
@@ -0,0 +1,96 @@
+//! Adapt a contained WinPTY command to the shared asynchronous process driver.
+
+use std::io::Read;
+use std::io::Write;
+use std::os::windows::io::AsRawHandle;
+use std::sync::Arc;
+use tokio::sync::broadcast;
+use tokio::sync::mpsc;
+use tokio::sync::oneshot;
+use winapi::um::processthreadsapi::GetExitCodeProcess;
+use winapi::um::synchapi::WaitForSingleObject;
+use winapi::um::winbase::INFINITE;
+
+use crate::ProcessDriver;
+use crate::SpawnedProcess;
+use crate::WindowsTtyInputNormalizer;
+use crate::spawn_from_driver;
+use crate::win::winpty::WinPtySpawn;
+
+/// Owns all transport and launch resources through command exit and final output.
+pub fn spawn_driver(spawned: WinPtySpawn, timeout_ms: Option<u64>) -> SpawnedProcess {
+    let WinPtySpawn {
+        session,
+        process,
+        thread,
+        mut input,
+        mut output,
+        owner,
+        job,
+    } = spawned;
+    let (writer_tx, mut writer_rx) = mpsc::channel::<Vec<u8>>(128);
+    let (stdout_tx, stdout_rx) = broadcast::channel::<Vec<u8>>(256);
+    let output_join = std::thread::spawn(move || {
+        let mut bytes = [0u8; 8192];
+        loop {
+            match output.read(&mut bytes) {
+                Ok(0) => break,
+                Ok(count) => {
+                    let _ = stdout_tx.send(bytes[..count].to_vec());
+                }
+                Err(error) if error.kind() == std::io::ErrorKind::Interrupted => continue,
+                Err(_) => break,
+            }
+        }
+    });
+    let writer_handle = tokio::task::spawn_blocking(move || {
+        let mut normalizer = WindowsTtyInputNormalizer::default();
+        while let Some(bytes) = writer_rx.blocking_recv() {
+            if input.write_all(&normalizer.normalize(&bytes)).is_err() || input.flush().is_err() {
+                break;
+            }
+        }
+    });
+    let (exit_tx, exit_rx) = oneshot::channel();
+    let wait_job = Arc::clone(&job);
+    let wait_session = Arc::clone(&session);
+    std::thread::spawn(move || {
+        let _owner = owner;
+        let _thread = thread;
+        let timeout = timeout_ms.map_or(INFINITE, |ms| ms.min(u64::from(u32::MAX - 1)) as u32);
+        let result = unsafe { WaitForSingleObject(process.as_raw_handle().cast(), timeout) };
+        let timed_out = result == 258;
+        if timed_out || result == u32::MAX {
+            let _ = wait_job.terminate();
+            unsafe { WaitForSingleObject(process.as_raw_handle().cast(), INFINITE) };
+        } else {
+            let _ = wait_job.preserve_descendants();
+        }
+        let mut exit_code = 1;
+        unsafe { GetExitCodeProcess(process.as_raw_handle().cast(), &mut exit_code) };
+        // AUTO_SHUTDOWN + EXIT_AFTER_SHUTDOWN make the agent emit the final
+        // console frame and close output before it exits. Do not free it early.
+        let _ = output_join.join();
+        if let Ok(mut console) = wait_session.lock() {
+            console.close();
+        }
+        let _ = exit_tx.send(if timed_out { 124 } else { exit_code as i32 });
+    });
+    spawn_from_driver(ProcessDriver {
+        writer_tx,
+        stdout_rx,
+        stderr_rx: None,
+        exit_rx,
+        terminator: Some(Box::new(move || {
+            let _ = job.terminate();
+        })),
+        writer_handle: Some(writer_handle),
+        resizer: Some(Box::new(move |size| {
+            session
+                .lock()
+                .map_err(|_| anyhow::anyhow!("WinPTY session lock poisoned"))?
+                .resize(size)
+        })),
+        tty: true,
+    })
+}
diff --git a/codex-rs/windows-sandbox-rs/examples/win7_pty_probe.rs b/codex-rs/windows-sandbox-rs/examples/win7_pty_probe.rs
new file mode 100644
index 0000000..7747aaa
--- /dev/null
+++ b/codex-rs/windows-sandbox-rs/examples/win7_pty_probe.rs
@@ -0,0 +1,364 @@
+//! Native Windows console verification for the Win7 maintenance build.
+
+#[cfg(not(windows))]
+fn main() {
+    eprintln!("Run this probe on Windows.");
+}
+
+#[cfg(windows)]
+fn main() -> anyhow::Result<()> {
+    use std::io::Write;
+    use windows_sys::Win32::Foundation::CloseHandle;
+    use windows_sys::Win32::Security::IsTokenRestricted;
+    use windows_sys::Win32::Security::TOKEN_QUERY;
+    use windows_sys::Win32::System::Console::CONSOLE_SCREEN_BUFFER_INFO;
+    use windows_sys::Win32::System::Console::GetConsoleMode;
+    use windows_sys::Win32::System::Console::GetConsoleScreenBufferInfo;
+    use windows_sys::Win32::System::Console::GetStdHandle;
+    use windows_sys::Win32::System::Console::STD_INPUT_HANDLE;
+    use windows_sys::Win32::System::Console::STD_OUTPUT_HANDLE;
+    use windows_sys::Win32::System::Threading::GetCurrentProcess;
+    use windows_sys::Win32::System::Threading::OpenProcessToken;
+
+    let args = std::env::args().collect::<Vec<_>>();
+    if args.get(1).is_some_and(|arg| arg == "--wait-child") {
+        std::thread::sleep(std::time::Duration::from_secs(300));
+        return Ok(());
+    }
+    if args
+        .get(1)
+        .is_some_and(|arg| arg == "--console-child" || arg == "--console-tree")
+    {
+        let mut mode = 0;
+        anyhow::ensure!(
+            unsafe { GetConsoleMode(GetStdHandle(STD_INPUT_HANDLE), &mut mode) } != 0,
+            "stdin is not a real Windows console"
+        );
+        let mut token = 0;
+        anyhow::ensure!(
+            unsafe { OpenProcessToken(GetCurrentProcess(), TOKEN_QUERY, &mut token) } != 0,
+            "query child token"
+        );
+        let restricted = unsafe { IsTokenRestricted(token) } != 0;
+        unsafe { CloseHandle(token) };
+        anyhow::ensure!(
+            restricted,
+            "console child did not retain its restricted token"
+        );
+        std::fs::write("pty-inside.txt", "WIN7_PTY_INSIDE")?;
+        let outside = args.get(2).expect("outside write fixture path");
+        match std::fs::write(outside, "must be denied") {
+            Err(error) if error.kind() == std::io::ErrorKind::PermissionDenied => {}
+            result => anyhow::bail!("outside write was not denied: {result:?}"),
+        }
+        println!("WIN7_REAL_CONSOLE_READY RESTRICTED_TOKEN_OK OUTSIDE_WRITE_DENIED");
+        std::io::stdout().flush()?;
+        if args[1] == "--console-tree" {
+            let marker = std::path::PathBuf::from(args.get(3).expect("process marker path"));
+            let mut child = match std::process::Command::new(std::env::current_exe()?)
+                .arg("--wait-child")
+                .spawn()
+            {
+                Ok(child) => child,
+                Err(error) => {
+                    std::fs::write(marker.with_extension("error.txt"), error.to_string())?;
+                    return Err(error.into());
+                }
+            };
+            let mut pids = [0u32; 32];
+            let deadline = std::time::Instant::now() + std::time::Duration::from_secs(10);
+            let count = loop {
+                let count = unsafe {
+                    windows_sys::Win32::System::Console::GetConsoleProcessList(
+                        pids.as_mut_ptr(),
+                        pids.len() as u32,
+                    )
+                };
+                if count >= 3 || std::time::Instant::now() >= deadline {
+                    break count;
+                }
+                if let Some(status) = child.try_wait()? {
+                    std::fs::write(
+                        marker.with_extension("error.txt"),
+                        format!("descendant exited during console attach: {status}"),
+                    )?;
+                    anyhow::bail!("descendant exited during console attach");
+                }
+                std::thread::sleep(std::time::Duration::from_millis(20));
+            };
+            if count < 3 {
+                std::fs::write(
+                    marker.with_extension("error.txt"),
+                    format!("console process list only has {count}: {pids:?}"),
+                )?;
+            }
+            anyhow::ensure!(
+                count >= 3 && count <= pids.len() as u32,
+                "console process tree count {count}"
+            );
+            std::fs::write(marker, serde_json::to_vec(&pids[..count as usize])?)?;
+            let _ = child.wait()?;
+            return Ok(());
+        }
+        loop {
+            let mut line = String::new();
+            if std::io::stdin().read_line(&mut line)? == 0 {
+                break;
+            }
+            let line = line.trim_end_matches(['\r', '\n']);
+            if line == "quit" {
+                println!("WIN7_PTY_BYE");
+                break;
+            }
+            if line == "size" {
+                let mut size: CONSOLE_SCREEN_BUFFER_INFO = unsafe { std::mem::zeroed() };
+                anyhow::ensure!(
+                    unsafe {
+                        GetConsoleScreenBufferInfo(GetStdHandle(STD_OUTPUT_HANDLE), &mut size)
+                    } != 0,
+                    "read console dimensions"
+                );
+                println!(
+                    "SIZE_{}x{}",
+                    size.srWindow.Right - size.srWindow.Left + 1,
+                    size.srWindow.Bottom - size.srWindow.Top + 1
+                );
+            } else {
+                println!("ECHO_{line}");
+            }
+            std::io::stdout().flush()?;
+        }
+        return Ok(());
+    }
+    let runtime = tokio::runtime::Builder::new_multi_thread()
+        .enable_all()
+        .build()?;
+    if args.get(1).is_some_and(|arg| arg == "--owner") {
+        return runtime.block_on(async {
+            let base = std::path::PathBuf::from(args.get(2).expect("owner base directory"));
+            let (_process, _outside) = launch(&base, "--console-tree", Some(300_000)).await?;
+            tokio::time::sleep(std::time::Duration::from_secs(300)).await;
+            Ok(())
+        });
+    }
+    runtime.block_on(run())
+}
+
+#[cfg(windows)]
+async fn launch(
+    base: &std::path::Path,
+    mode: &str,
+    timeout_ms: Option<u64>,
+) -> anyhow::Result<(codex_utils_pty::SpawnedProcess, std::path::PathBuf)> {
+    use codex_protocol::models::PermissionProfile;
+    use codex_utils_absolute_path::AbsolutePathBuf;
+    let workspace = base.join("workspace");
+    let home = base.join("codex-home");
+    std::fs::create_dir_all(&workspace)?;
+    std::fs::create_dir_all(&home)?;
+    let outside = base.join("outside.txt");
+    let roots = vec![AbsolutePathBuf::from_absolute_path(workspace.clone())?];
+    let permission = PermissionProfile::workspace_write();
+    let command = vec![
+        std::env::current_exe()?.display().to_string(),
+        mode.to_string(),
+        outside.display().to_string(),
+        workspace.join("tree-pids.json").display().to_string(),
+    ];
+    let spawned = codex_windows_sandbox::spawn_windows_sandbox_session_legacy(
+        &permission,
+        &roots,
+        &home,
+        command,
+        &workspace,
+        std::env::vars().collect(),
+        timeout_ms,
+        &[],
+        &[],
+        /*tty*/ true,
+        /*stdin_open*/ true,
+        /*use_private_desktop*/ true,
+    )
+    .await?;
+    Ok((spawned, outside))
+}
+
+#[cfg(windows)]
+async fn run() -> anyhow::Result<()> {
+    use anyhow::Context;
+    use codex_utils_pty::SpawnedProcess;
+    use codex_utils_pty::TerminalSize;
+    use std::os::windows::io::AsRawHandle;
+    use std::os::windows::io::FromRawHandle;
+    use std::os::windows::io::OwnedHandle;
+    use std::path::Path;
+    use std::time::Duration;
+    use windows_sys::Win32::System::Threading::OpenProcess;
+    use windows_sys::Win32::System::Threading::PROCESS_SYNCHRONIZE;
+    use windows_sys::Win32::System::Threading::WaitForSingleObject;
+
+    async fn expect(
+        spawned: &mut SpawnedProcess,
+        output: &mut Vec<u8>,
+        marker: &str,
+    ) -> anyhow::Result<()> {
+        tokio::time::timeout(Duration::from_secs(90), async {
+            loop {
+                if String::from_utf8_lossy(output).contains(marker) {
+                    return Ok(());
+                }
+                match spawned.stdout_rx.recv().await {
+                    Some(chunk) => output.extend(chunk),
+                    None => anyhow::bail!(
+                        "output ended before {marker}: {}",
+                        String::from_utf8_lossy(output)
+                    ),
+                }
+                anyhow::ensure!(
+                    output.len() < 1024 * 1024,
+                    "unexpected console output volume"
+                );
+            }
+        })
+        .await
+        .with_context(|| {
+            format!(
+                "waiting for {marker}; output={}",
+                String::from_utf8_lossy(output)
+            )
+        })?
+    }
+
+    let base = std::env::current_dir()?.join(format!("win7-pty-probe-{}", std::process::id()));
+    let (mut spawned, outside) =
+        launch(&base.join("interactive"), "--console-child", Some(120_000)).await?;
+    println!("PHASE interactive started");
+    let mut output = Vec::new();
+    expect(&mut spawned, &mut output, "OUTSIDE_WRITE_DENIED").await?;
+    spawned
+        .session
+        .writer_sender()
+        .send("你好_win7\n".as_bytes().to_vec())
+        .await?;
+    expect(&mut spawned, &mut output, "ECHO_你好_win7").await?;
+    spawned
+        .session
+        .writer_sender()
+        .send(b"abc\x1b[D\x7fZ\r".to_vec())
+        .await?;
+    expect(&mut spawned, &mut output, "ECHO_aZc").await?;
+    spawned.session.resize(TerminalSize {
+        cols: 120,
+        rows: 35,
+    })?;
+    spawned
+        .session
+        .writer_sender()
+        .send(b"size\r".to_vec())
+        .await?;
+    expect(&mut spawned, &mut output, "SIZE_120x35").await?;
+    spawned
+        .session
+        .writer_sender()
+        .send(b"quit\r".to_vec())
+        .await?;
+    expect(&mut spawned, &mut output, "WIN7_PTY_BYE").await?;
+    let exit = tokio::time::timeout(Duration::from_secs(30), &mut spawned.exit_rx).await??;
+    anyhow::ensure!(exit == 0, "console exit code {exit}");
+    anyhow::ensure!(!outside.exists(), "outside write escaped workspace");
+    println!("PHASE interactive passed");
+
+    let (mut interrupted, _) =
+        launch(&base.join("ctrl-c"), "--console-child", Some(120_000)).await?;
+    expect(&mut interrupted, &mut Vec::new(), "OUTSIDE_WRITE_DENIED").await?;
+    interrupted.session.writer_sender().send(vec![3]).await?;
+    println!("PHASE Ctrl+C sent");
+    let interrupt_exit = tokio::time::timeout(Duration::from_secs(30), &mut interrupted.exit_rx)
+        .await
+        .context("Ctrl+C console exit")??;
+    anyhow::ensure!(
+        interrupt_exit != 0,
+        "Ctrl+C did not interrupt the console process"
+    );
+    println!("PHASE Ctrl+C passed");
+
+    async fn track(path: &Path) -> anyhow::Result<Vec<OwnedHandle>> {
+        let pids: Vec<u32> = tokio::time::timeout(Duration::from_secs(60), async {
+            loop {
+                if let Ok(data) = std::fs::read(path) {
+                    return serde_json::from_slice(&data);
+                }
+                if let Ok(error) = std::fs::read_to_string(path.with_extension("error.txt")) {
+                    return Err(serde_json::Error::io(std::io::Error::other(error)));
+                }
+                tokio::time::sleep(Duration::from_millis(50)).await;
+            }
+        })
+        .await??;
+        anyhow::ensure!(pids.len() >= 3, "agent/command/descendant not all tracked");
+        let mut handles = Vec::new();
+        for pid in pids {
+            let handle = unsafe { OpenProcess(PROCESS_SYNCHRONIZE, 0, pid) };
+            anyhow::ensure!(handle != 0, "open console process {pid}");
+            let handle = unsafe { OwnedHandle::from_raw_handle(handle as _) };
+            anyhow::ensure!(
+                unsafe { WaitForSingleObject(handle.as_raw_handle() as _, 0) } == 258,
+                "console process already exited"
+            );
+            handles.push(handle);
+        }
+        Ok(handles)
+    }
+
+    fn exited(handles: &[OwnedHandle]) -> anyhow::Result<()> {
+        for handle in handles {
+            anyhow::ensure!(
+                unsafe { WaitForSingleObject(handle.as_raw_handle() as _, 15000) } == 0,
+                "console agent or descendant survived"
+            );
+        }
+        Ok(())
+    }
+
+    for timed_out in [false, true] {
+        println!("PHASE tree timed_out={timed_out}");
+        let case = base.join(if timed_out { "timeout" } else { "cancel" });
+        let (mut tree, _) = launch(
+            &case,
+            "--console-tree",
+            Some(if timed_out { 15_000 } else { 120_000 }),
+        )
+        .await?;
+        let handles = track(&case.join("workspace/tree-pids.json")).await?;
+        if !timed_out {
+            tree.session.request_terminate();
+        }
+        let exit = tokio::time::timeout(Duration::from_secs(45), &mut tree.exit_rx)
+            .await
+            .context("tree exit")??;
+        anyhow::ensure!(
+            exit != 0 && (!timed_out || exit == 124),
+            "unexpected tree exit {exit}"
+        );
+        exited(&handles)?;
+    }
+
+    let case = base.join("owner-crash");
+    println!("PHASE owner crash");
+    std::fs::create_dir_all(&case)?;
+    let mut owner = std::process::Command::new(std::env::current_exe()?)
+        .arg("--owner")
+        .arg(&case)
+        .stdout(std::process::Stdio::null())
+        .stderr(std::fs::File::create(case.join("owner.log"))?)
+        .spawn()?;
+    let handles = track(&case.join("workspace/tree-pids.json")).await?;
+    owner.kill()?;
+    let _ = owner.wait()?;
+    exited(&handles)?;
+    println!(
+        "{}",
+        serde_json::json!({"passed":true,"exit":exit,"restricted_token":true,"outside_write_denied":true,"unicode_input":true,"line_editing":true,"resize":"120x35","ctrl_c":true,"cancel_tree":true,"timeout_tree":true,"owner_crash_tree":true,"output":String::from_utf8_lossy(&output)})
+    );
+    Ok(())
+}
diff --git a/compat/win7/README.md b/compat/win7/README.md
new file mode 100644
index 0000000..4230060
--- /dev/null
+++ b/compat/win7/README.md
@@ -0,0 +1,85 @@
+# Win7 Codex 维护分支
+
+本分支基于上游 `rust-v0.149.1`，使用 Rust 1.95.0 的 `x86_64-win7-windows-msvc` 目标重新构建标准库。
+Go 服务使用 CSGClaw 仓库中的 Win7 兼容 Go 工具链构建。
+
+## 兼容实现
+
+`imports.c` 为六个可选 Windows API 提供动态解析和兼容返回值。
+Windows 7 SP1 需要 KB3063858 或包含相同安全加载功能的后续更新。
+不存在的 ConPTY 和 WinRT 能力返回不支持，不伪造成功。
+
+CSGClaw 在 Windows 7 上使用允许协作进程显式脱离的外层 Job。
+Codex 以挂起状态创建受限命令，并在恢复执行前将它加入禁止脱离的独立命令 Job。
+受限令牌和工作区 ACL 保持不变。
+加入命令 Job 失败时终止挂起进程。
+Windows 8 及以后继续使用原有嵌套 Job 路径。
+
+Windows 7 上，正常结束的命令可以留下后台任务，但 app-server 会保留这些后台 Job 的所有权。
+后续保留后台 Job 时会释放已经没有活动进程的 Job 句柄。
+app-server 被关闭或终止后，系统关闭其句柄并回收剩余后台任务。
+
+旧系统不支持原子的 JOB_LIST 创建属性。
+先挂起、再加入 Job 的方式仍有进程创建与加入之间的窗口，调用方异常终止时可能留下尚未执行用户代码的挂起进程。
+当前生命周期测试覆盖已经启动的命令树和后台命令，不证明该极短创建窗口内的崩溃行为。
+
+## WinPTY
+
+源码固定为 MIT 许可的 WinPTY 0.4.3，提交 `3e1ab962d5262dd76159870c6dc0724927ca6a9d`。
+`build-winpty.py` 校验源码归档 SHA-256 后应用 `winpty-sandbox.patch`，使用 Windows 7 SDK 目标和静态 CRT 构建。
+补丁让可信控制台 agent 使用实际受限令牌挂起启动，严格加入命令 Job 后恢复，用户命令继承相同约束。
+指定环境、工作目录和私有桌面同步传递，控制管道仅增加同一登录 SID 的访问权限。
+失败时不重试无沙箱进程。
+
+`winpty.dll` 只从当前 Codex 可执行文件同目录加载。
+交互式工具能力检查同时支持 ConPTY 和配套 WinPTY，现代 Windows 优先使用 ConPTY。
+输出以终端流传递，输入、行编辑、Ctrl+C 和窗口调整使用真实控制台。
+
+## 本机构建
+
+需要 Rust 1.95.0 的 rust-src、cargo-xwin 0.23.1、Homebrew LLVM 和 LLD，以及 cargo-xwin 下载的 Windows SDK。
+WinPTY 构建需要 Python 3.12 或更高版本。
+首次准备应运行 `rustup component add rust-src --toolchain 1.95.0`。
+若 windows_x86_64_msvc 0.48.5 的导入库搜索失败，LIB 需包含 Cargo registry 中该包的 lib 目录。
+
+```sh
+compat/win7/build-macos.sh
+# 使用开发构建以便快速迭代：
+WIN7_PROFILE=dev compat/win7/build-macos.sh
+```
+
+构建脚本把兼容对象文件放在系统导入库之前链接。
+默认使用 release 配置，开发验证也使用过 dev 配置。
+产物目录包含 `codex.exe`、`winpty.dll`、`winpty-agent.exe` 和 `LICENSE.winpty`，分发时必须一起携带。
+
+## 验证
+
+CSGClaw 的 `internal/runtime/codex/win7_sandbox_windows_test.go` 覆盖真实 Runtime 到此 Codex app-server 的调用。
+设置 `CSGCLAW_TEST_CODEX_BINARY` 指向构建产物后，在 Win7 原生运行对应 Windows 测试二进制。
+测试覆盖工作区写入、目录外写入拒绝、取消、超时、后台进程回收、app-server 崩溃回收，以及取消和超时后的继续对话。
+不要以 Mac 上的 Rust 测试代替 Windows 原生生命周期测试。
+
+`windows-sandbox-rs/examples/win7_pty_probe.rs` 是原生控制台探针。
+以同一 Win7 工具链构建后，与 DLL 和 agent 放在同目录运行。
+探针检查真实控制台、受限令牌、工作区边界、中文输入、行编辑、缩放、Ctrl+C、取消、超时及拥有者崩溃后的进程句柄终态。
+CSGClaw 的 `TestWindowsInteractiveCodexToolsE2E` 还通过确定性模型服务驱动真实 `exec_command` 和 `write_stdin`。
+该测试需设置 `CSGCLAW_TEST_CONSOLE_PROBE` 指向探针可执行文件。
+
+## 取消归属与维护检查
+
+旧 Windows 在回合中断时按 turn ID 终止该回合创建的交互终端，并在发送中断事件前完成清理。
+其他回合持有的后台服务不会被这一操作终止。
+CSGClaw 的原生测试和真实浏览器 Stop 操作均检查父子进程句柄退出，并验证同一会话还能继续使用。
+
+macOS 全仓测试可运行 `python3 compat/win7/test-macos.py`。
+脚本通过 `just test` 执行，隔离个人配置与桌面进程注入的代理、CLI 路径和 HOME，保留沙箱相关环境变量。
+它支持透传 nextest 参数，例如 `--test-threads 4`。
+V8 依赖须按仓库 setup-rusty-v8 工作流准备匹配的归档与绑定文件。
+测试 fixture 对 release 版本号、macOS 临时目录和本机已安装 Codex 路径作了确定性处理，不改变生产运行行为。
+
+## 当前边界
+
+这里维护的是 CLI/app-server，不是 Codex 桌面应用或 Electron。
+Win7 的交互式终端由配套 WinPTY 后端提供，ConPTY 探测仍如实返回不可用。
+不通过禁用 `unified_exec` 或放开默认工作区沙箱实现兼容。
+升级分发必须固定本分支的独立产物，不能被普通 Windows 最新二进制覆盖。
