diff --git a/.github/workflows/win7-compat.yml b/.github/workflows/win7-compat.yml
new file mode 100644
index 00000000..ed8d7f3e
--- /dev/null
+++ b/.github/workflows/win7-compat.yml
@@ -0,0 +1,199 @@
+name: Win7 build and release
+
+on:
+  push:
+    branches: [main]
+    tags: ["**"]
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+concurrency:
+  group: win7-compat-${{ github.ref }}
+  cancel-in-progress: true
+
+jobs:
+  portable:
+    if: github.repository == 'OpenCSGs/csgclaw-win7'
+    runs-on: windows-2022
+    timeout-minutes: 60
+    outputs:
+      version: ${{ steps.release_meta.outputs.version }}
+    env:
+      GOTOOLCHAIN: local
+      GOWORK: "off"
+      CGO_ENABLED: "0"
+      TARGET_OS: windows
+      TARGET_ARCH: amd64
+      CSGCLAW_DESKTOP_GOOS: windows
+      CSGCLAW_DESKTOP_GOARCH: amd64
+      CSGCLAW_DESKTOP_ARCH: x64
+      CSGCLAW_DESKTOP_WINDOWS_CHANNEL: website
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          persist-credentials: false
+
+      - uses: actions/setup-node@v4
+        with:
+          node-version: 24.15.0
+
+      - uses: pnpm/action-setup@v4
+        with:
+          version: 11.1.3
+
+      - name: Resolve build version
+        id: release_meta
+        shell: pwsh
+        run: |
+          $version = "0.8.0-alpha.win7.$env:GITHUB_RUN_NUMBER"
+          if ($env:GITHUB_REF_TYPE -eq "tag") {
+            $version = $env:GITHUB_REF_NAME -replace '^v', ''
+            if ($version -notmatch '^(0|[1-9]\d*)\.(0|[1-9]\d*)\.(0|[1-9]\d*)(-[0-9A-Za-z-]+(\.[0-9A-Za-z-]+)*)?$') {
+              throw "Release tags must be semantic versions, for example v0.8.0-alpha.win7.3"
+            }
+          }
+          "VERSION=$version" >> $env:GITHUB_ENV
+          "CSGCLAW_DESKTOP_VERSION=$version" >> $env:GITHUB_ENV
+          "version=$version" >> $env:GITHUB_OUTPUT
+
+      - name: Install pinned Win7 Go toolchain
+        shell: pwsh
+        run: |
+          $archive = Join-Path $env:RUNNER_TEMP "go-win7.zip"
+          Invoke-WebRequest "https://github.com/XTLS/go-win7/releases/download/patched-1.26.7/go-for-win7-windows-amd64.zip" -OutFile $archive
+          $expected = "b88e6c1baf285110130e33959a9082f7a81f44202f32767e8ed34b6a7a31dcff"
+          if ((Get-FileHash $archive -Algorithm SHA256).Hash.ToLowerInvariant() -ne $expected) {
+            throw "Win7 Go SDK SHA-256 mismatch"
+          }
+          $sdk = Join-Path $env:RUNNER_TEMP "go-win7"
+          Expand-Archive $archive -DestinationPath $sdk
+          if (!(Test-Path "$sdk/bin/go.exe")) { throw "Invalid Win7 SDK layout" }
+          "$sdk/bin" >> $env:GITHUB_PATH
+          "GOROOT=$sdk" >> $env:GITHUB_ENV
+          "COMMIT=$($env:GITHUB_SHA.Substring(0, 12))" >> $env:GITHUB_ENV
+          "BUILD_TIME=$([DateTime]::UtcNow.ToString('yyyy-MM-ddTHH:mm:ssZ'))" >> $env:GITHUB_ENV
+
+      - name: Install frozen dependencies
+        shell: pwsh
+        run: |
+          pnpm --dir desktop install --frozen-lockfile
+          if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
+          pnpm --dir web/app install --frozen-lockfile
+          if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
+
+      - name: Verify desktop compatibility and update isolation
+        shell: pwsh
+        run: |
+          pnpm --dir desktop test
+          if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
+
+      - name: Build actual Web UI and bundled backend
+        shell: pwsh
+        run: |
+          go version
+          ./scripts/build.cmd build-web
+          if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
+          ./scripts/build.cmd desktop-backend-bundle
+          if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
+          & ./desktop/out/input/windows-amd64/backend/csgclaw/bin/csgclaw.exe --version
+          if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
+          & ./desktop/out/input/windows-amd64/backend/csgclaw/bin/csgclaw-cli.exe --version
+          if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
+
+      - name: Package portable desktop
+        shell: pwsh
+        run: |
+          pnpm --dir desktop exec electron-forge package --platform=win32 --arch=x64
+          if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
+          $config = Get-Content desktop/out/CSGClaw-win32-x64/resources/desktop-update.json -Raw | ConvertFrom-Json
+          if ($config.disabled -ne $true -or $config.base_url -or $config.channels_base_url) {
+            throw "Compatibility package unexpectedly contains an update feed"
+          }
+          New-Item compat-dist -ItemType Directory | Out-Null
+          $zip = "compat-dist/CSGClaw-$env:VERSION-win7-x64-portable.zip"
+          Compress-Archive desktop/out/CSGClaw-win32-x64 -DestinationPath $zip
+          $hash = (Get-FileHash $zip -Algorithm SHA256).Hash.ToLowerInvariant()
+          "$hash  $([IO.Path]::GetFileName($zip))" | Set-Content compat-dist/SHA256SUMS.txt
+          @{
+            version = $env:VERSION
+            commit = $env:GITHUB_SHA
+            base_version = "v0.8.0"
+            electron = "22.3.27"
+            go_toolchain = "XTLS/go-win7 patched-1.26.7"
+            updates_disabled = $true
+            codex_win7_compatibility = "Not resolved; excluded from initial page-launch acceptance"
+          } | ConvertTo-Json | Set-Content compat-dist/build-info.json
+
+      - uses: actions/upload-artifact@v4
+        with:
+          name: csgclaw-win7-x64-${{ github.sha }}
+          path: compat-dist/
+          if-no-files-found: error
+          retention-days: 14
+          compression-level: 0
+
+      - name: Summarize build
+        shell: pwsh
+        run: |
+          "Win7 SP1 x64 build $env:VERSION from $env:GITHUB_SHA. Download the portable ZIP from this run's artifacts; tag builds also publish it to this repository's Releases. Updates are disabled. A successful build is not a Win7 runtime test." >> $env:GITHUB_STEP_SUMMARY
+
+  release:
+    if: github.ref_type == 'tag'
+    needs: [portable]
+    runs-on: ubuntu-latest
+    permissions:
+      contents: write
+    steps:
+      - uses: actions/download-artifact@v4
+        with:
+          name: csgclaw-win7-x64-${{ github.sha }}
+          path: compat-dist
+
+      - name: Verify portable package checksum
+        env:
+          VERSION: ${{ needs.portable.outputs.version }}
+        run: |
+          python3 - <<'PY'
+          import hashlib
+          import json
+          import os
+          from pathlib import Path
+
+          root = Path("compat-dist")
+          package = root / f"CSGClaw-{os.environ['VERSION']}-win7-x64-portable.zip"
+          expected, filename = (root / "SHA256SUMS.txt").read_text(encoding="utf-8-sig").strip().split(maxsplit=1)
+          digest = hashlib.sha256()
+          with package.open("rb") as archive:
+              for chunk in iter(lambda: archive.read(1024 * 1024), b""):
+                  digest.update(chunk)
+          actual = digest.hexdigest()
+          if filename != package.name or actual != expected:
+              raise SystemExit("Portable package SHA-256 mismatch")
+          info = json.loads((root / "build-info.json").read_text(encoding="utf-8-sig"))
+          if info["version"] != os.environ["VERSION"] or info["commit"] != os.environ["GITHUB_SHA"]:
+              raise SystemExit("Portable package build metadata mismatch")
+          PY
+
+      - name: Publish Win7 release
+        uses: softprops/action-gh-release@v2
+        with:
+          tag_name: ${{ github.ref_name }}
+          target_commitish: ${{ github.sha }}
+          name: CSGClaw Win7 ${{ needs.portable.outputs.version }}
+          prerelease: ${{ contains(needs.portable.outputs.version, '-') }}
+          fail_on_unmatched_files: true
+          body: |
+            Windows 7 SP1 x64 compatibility build based on CSGClaw v0.8.0.
+
+            - Download the portable ZIP, extract it completely, and run CSGClaw.exe.
+            - SHA256SUMS.txt contains the package checksum; build-info.json records the source commit and toolchain.
+            - Electron 22.3.27, Chromium 108 Web UI target, and XTLS/go-win7 patched-1.26.7. Desktop automatic updates are disabled.
+            - Known Win7 issues: model HTTPS requests can time out during TLS negotiation; the bundled Codex runtime exits with 0xC0000139. Agent question answering has not passed validation.
+
+            Built by [GitHub Actions](${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}).
+          files: |
+            compat-dist/CSGClaw-${{ needs.portable.outputs.version }}-win7-x64-portable.zip
+            compat-dist/SHA256SUMS.txt
+            compat-dist/build-info.json
